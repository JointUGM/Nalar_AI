# Copy to .env for local runs. Every variable maps to a field in src/nalar_ai/settings.py.
NALAR_AI_ENVIRONMENT=local
NALAR_AI_SERVICE_KEY=change-me-to-a-long-random-string

# sumopod | fake  (fake runs without network; useful for UI work and OpenAPI export)
NALAR_AI_LLM_PROVIDER=sumopod
NALAR_AI_SUMOPOD_API_KEY=
# Verify both URLs on day one with: uv run python scripts/sumopod_probe.py
NALAR_AI_SUMOPOD_MESSAGES_BASE_URL=https://ai.sumopod.com
NALAR_AI_SUMOPOD_OPENAI_BASE_URL=https://ai.sumopod.com/v1
# native = output_config.format JSON schema; prompt = schema embedded in the prompt
NALAR_AI_STRUCTURED_OUTPUT=native

NALAR_AI_MODEL_FAST=claude-haiku-4-5
NALAR_AI_MODEL_QUALITY=claude-sonnet-5
NALAR_AI_MODEL_JUDGE=claude-opus-5
NALAR_AI_EMBEDDING_MODEL=text-embedding-3-small
NALAR_AI_EMBEDDING_DIMENSIONS=1536

NALAR_AI_LLM_TIMEOUT_SECONDS=120
NALAR_AI_LLM_MAX_ATTEMPTS=3
NALAR_AI_LLM_CONCURRENCY=4
NALAR_AI_MAX_COST_USD_PER_REQUEST=1.0
NALAR_AI_MAX_UPLOAD_BYTES=52428800
